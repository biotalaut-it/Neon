# Default model for the main NEON runtime
NEON_LLAMA_SERVER="$HOME/llama.cpp/build/bin/llama-server"
NEON_MODEL_PATH="$HOME/models/default-model.gguf"

# Optional role-specific model overrides.
# Susan is prepared to use a dedicated coding model later.
NEON_MODEL_SUSAN="$HOME/models/qwen2.5-coder-3b-instruct-q4_k_m.gguf"
NEON_MODEL_PROGRAMMER="$HOME/models/qwen2.5-coder-3b-instruct-q4_k_m.gguf"

# Reserved for future role-specific models
NEON_MODEL_LEADER=""
NEON_MODEL_FANI=""
NEON_MODEL_DEBY=""
NEON_MODEL_DYOR=""
NEON_MODEL_MIKE=""
NEON_MODEL_JORDAN=""

# Runtime tuning
NEON_CONTEXT=4096
NEON_THREADS=4
NEON_PORT=8089
NEON_AGENT_CALLS=8
NEON_WORKSPACE="$HOME/neon-workspace"
NEON_DATA_DIR="$HOME/.local/share/neon"
